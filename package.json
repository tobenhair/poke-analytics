{
  "name": "poke-analytics",
  "version": "1.0.0",
  "description": "CI tooling for the Pokémon TCG sealed-product dashboard (the app itself is the framework-free index.html).",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-workbook.mjs",
    "backup": "node scripts/export-backup.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "test": "npm run test:unit && npm run validate && npm run check:dead-code && npm run check:design-tokens && npm run test:e2e",
    "scale:fixture": "node scripts/gen-scale-fixture.mjs",
    "scale:measure": "node scripts/measure-scale.mjs",
    "cardmarket:spike": "node scripts/cardmarket-spike.mjs",
    "cardmarket:ingest": "node scripts/cardmarket-ingest.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.0",
    "@supabase/supabase-js": "^2.45.0",
    "chart.js": "4.4.1",
    "chartjs-plugin-zoom": "2.2.0",
    "hammerjs": "2.0.8",
    "xlsx": "^0.18.5"
  }
}
